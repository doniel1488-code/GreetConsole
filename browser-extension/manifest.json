{
  "manifest_version": 3,
  "name": "GreetConsole — Minecraft Console",
  "short_name": "GreetConsole",
  "version": "1.0.2",
  "description": "Окно журнала Minecraft, игровой чат и команды от имени игрока.",
  "key": "",
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "Открыть GreetConsole",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:38761/*"
  ]
}